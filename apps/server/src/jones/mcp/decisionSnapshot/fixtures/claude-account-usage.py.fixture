#!/usr/bin/env python3
"""No-prompt native quota observation; advice carries no launch authority.

The SDK supplies no upstream observation timestamp. Local receipt time bounds
cache age, but cannot establish zero upstream lag. All returned model scopes
constrain the requested model conservatively, without display-name inference.
An explicit zero-used window may retain a null reset; its deadline is unknown.
"""
from __future__ import annotations

import argparse
from contextlib import contextmanager
from datetime import datetime, timedelta, timezone
import fcntl
import json
import math
import os
from pathlib import Path
import re
import selectors
import signal
import stat
import subprocess
import sys
import time

MAX_BYTES = 65536
CACHE_SECONDS = 120
DISPLAY_CACHE_SECONDS = 300
COOLDOWN_SECONDS = 180
PROBE_SECONDS = 35
SCHEMA = 'claude.account-usage/v1'


class Unavailable(ValueError):
    pass


def utc(value):
    if type(value) is not str or len(value) > 64:
        raise Unavailable()
    value = datetime.fromisoformat(value.replace('Z', '+00:00'))
    if value.tzinfo is None or value.utcoffset().total_seconds() != 0:
        raise Unavailable()
    return value.astimezone(timezone.utc)


def stamp(value):
    return value.isoformat().replace('+00:00', 'Z')


def unique_object(pairs):
    value = {}
    for key, item in pairs:
        if key in value:
            raise Unavailable()
        value[key] = item
    return value


def loads(raw):
    if len(raw) > MAX_BYTES:
        raise Unavailable()
    return json.loads(raw, object_pairs_hook=unique_object,
                      parse_constant=lambda _: (_ for _ in ()).throw(Unavailable()))


def unavailable(reason, **extra):
    return {'schema': SCHEMA, 'authority_effect': 'none', 'status': 'unavailable',
            'next_action': 'check_usage', 'reason': reason, **extra}


def normalize(observation, args, now, source):
    if type(observation) is not dict or observation.get('status') != 'observed':
        raise Unavailable()
    if observation.get('account') != args.account or not re.fullmatch('[0-9a-f]{64}', observation.get('fingerprint', '')):
        raise Unavailable()
    config = observation.get('config_dir')
    if config != str(Path.home() / '.claude-t3' / args.account):
        raise Unavailable()
    purpose = getattr(args, 'purpose', 'admission')
    if purpose not in ('admission', 'display'):
        raise Unavailable()
    received = utc(observation.get('received_at'))
    age = (now - received).total_seconds()
    max_age = DISPLAY_CACHE_SECONDS if purpose == 'display' else CACHE_SECONDS
    if not 0 <= age <= max_age:
        raise Unavailable()
    windows = observation.get('windows')
    if type(windows) is not dict or windows.keys() - {'five_hour', 'seven_day', 'seven_day_opus', 'seven_day_sonnet', 'seven_day_oauth_apps', 'model_scoped'}:
        raise Unavailable()

    def window(raw):
        if type(raw) is not dict or set(raw) != {'utilization', 'resets_at'}:
            raise Unavailable()
        used = raw['utilization']
        if type(used) not in (int, float) or not math.isfinite(used) or not 0 <= used <= 100:
            raise Unavailable()
        if raw['resets_at'] is None:
            if used != 0:
                raise Unavailable()
        elif utc(raw['resets_at']) <= now:
            raise Unavailable()
        return {'remaining_percent': 100 - used, 'observed_at': observation['received_at'],
                'reset_at': raw['resets_at']}

    five, weekly = window(windows.get('five_hour')), window(windows.get('seven_day'))
    family = 'seven_day_opus' if args.model.startswith('claude-opus-') else 'seven_day_sonnet'
    applicable = []
    for key in (family, 'seven_day_oauth_apps'):
        if key not in windows:
            raise Unavailable()
        if windows[key] is not None:
            applicable.append(window(windows[key]))
    scopes = windows.get('model_scoped', [])
    if type(scopes) is not list or len(scopes) > 64:
        raise Unavailable()
    applicable.extend(window(item) for item in scopes)
    model_window = None
    if applicable:
        known_resets = [item['reset_at'] for item in applicable if item['reset_at'] is not None]
        model_window = {'remaining_percent': min(item['remaining_percent'] for item in applicable),
                        'observed_at': observation['received_at'],
                        'reset_at': min(known_resets, key=utc) if known_resets else None}
    return {'schema': SCHEMA, 'authority_effect': 'none', 'status': 'observed',
            'source': source, 'binding_verified': True, 'received_at': observation['received_at'],
            'purpose': purpose, 'age_seconds': age, 'cache_max_age_seconds': max_age,
            'freshness': 'admission_fresh' if age <= CACHE_SECONDS else 'display_only',
            'admission_eligible': purpose == 'admission',
            'timestamp_basis': 'local_receipt_upstream_lag_unknown',
            'model_scope_policy': 'all_returned_scopes_conservative',
            'account': {'account': args.account, 'alias': args.account, 'config_dir': config,
                        'binding_verified': True, 'protected': args.protected,
                        'five_hour': five, 'weekly': weekly, 'model_weekly': {args.model: model_window}}}


def private_file(fd):
    metadata = os.fstat(fd)
    if (not stat.S_ISREG(metadata.st_mode) or metadata.st_uid != os.getuid()
            or metadata.st_mode & 0o077 or metadata.st_nlink != 1 or metadata.st_size > MAX_BYTES):
        raise Unavailable()


@contextmanager
def state_directory(path):
    path = Path(path)
    if not path.is_absolute() or '..' in path.parts:
        raise Unavailable()
    fd = os.open('/', os.O_RDONLY | os.O_DIRECTORY)
    private_anchor = False
    try:
        for index, part in enumerate(path.parts[1:]):
            try:
                os.mkdir(part, 0o700, dir_fd=fd)
            except FileExistsError:
                pass
            child = os.open(part, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=fd)
            metadata = os.fstat(child)
            final = index == len(path.parts) - 2
            if (metadata.st_uid not in (0, os.getuid()) or metadata.st_mode & 0o002
                    or (metadata.st_mode & 0o020 and not private_anchor)
                    or (final and (metadata.st_uid != os.getuid() or metadata.st_mode & 0o077))):
                os.close(child)
                raise Unavailable()
            os.close(fd)
            fd = child
            private_anchor = private_anchor or (metadata.st_uid == os.getuid() and not metadata.st_mode & 0o077)
        yield fd
    finally:
        os.close(fd)


def read_state(directory, name):
    try:
        fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=directory)
    except FileNotFoundError:
        return {}
    try:
        private_file(fd)
        value = loads(os.read(fd, MAX_BYTES + 1))
        if type(value) is not dict:
            raise Unavailable()
        return value
    finally:
        os.close(fd)


def write_state(directory, name, value):
    raw = json.dumps(value, allow_nan=False, sort_keys=True).encode()
    if len(raw) > MAX_BYTES:
        raise Unavailable()
    temp_name = '.write-' + os.urandom(12).hex()
    fd = os.open(temp_name, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600, dir_fd=directory)
    try:
        with os.fdopen(fd, 'wb') as stream:
            stream.write(raw)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temp_name, name, src_dir_fd=directory, dst_dir_fd=directory)
    finally:
        try:
            os.unlink(temp_name, dir_fd=directory)
        except FileNotFoundError:
            pass


def host_boot_id():
    value = Path('/proc/sys/kernel/random/boot_id').read_text().strip()
    if not re.fullmatch(r'[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}', value):
        raise Unavailable()
    return value


def process_identity(pid):
    try:
        with open(Path('/proc') / str(pid) / 'stat') as stream:
            raw = stream.read(4096)
    except FileNotFoundError:
        return None
    prefix, separator, fields = raw.rpartition(')')
    fields = fields.split()
    if not separator or prefix.split(' (', 1)[0] != str(pid) or len(fields) < 20:
        raise Unavailable()
    return {'pgid': int(fields[2]), 'session': int(fields[3]), 'start_ticks': int(fields[19])}


def operation_absent(marker, account):
    """Only a changed host boot or confirmed exact group absence releases a fence."""
    required = {'operation_id', 'account', 'host_boot_id', 'pid', 'pgid', 'start_ticks'}
    if (type(marker) is not dict or set(marker) != required or marker.get('account') != account
            or not re.fullmatch('[0-9a-f]{32}', str(marker.get('operation_id', '')))
            or not re.fullmatch(r'[0-9a-f]{8}(?:-[0-9a-f]{4}){3}-[0-9a-f]{12}',
                                str(marker.get('host_boot_id', '')))):
        return False
    try:
        if host_boot_id() != marker['host_boot_id']:
            return True
        if (any(type(marker[key]) is not int or marker[key] <= 0
                for key in ('pid', 'pgid', 'start_ticks')) or marker['pid'] != marker['pgid']):
            return False
        identity = process_identity(marker['pid'])
        if identity is not None and (identity['pgid'] != marker['pgid']
                                    or identity['session'] != marker['pid']
                                    or identity['start_ticks'] != marker['start_ticks']):
            return False
        try:
            os.killpg(marker['pgid'], 0)
        except ProcessLookupError:
            return identity is None
    except (OSError, Unavailable, ValueError, TypeError, OverflowError):
        pass
    return False


def bind_process_lifecycle(args, directory, name, state):
    def before_spawn():
        if not hasattr(signal, 'pthread_sigmask'):
            raise Unavailable()
        boot = host_boot_id()
        if process_identity(os.getpid()) is None:
            raise Unavailable()
        state['operation'] = {'operation_id': os.urandom(16).hex(), 'account': args.account,
                              'host_boot_id': boot, 'pid': None, 'pgid': None, 'start_ticks': None}
        write_state(directory, name, state)

    def on_spawn(process):
        identity = process_identity(process.pid)
        if identity is None or identity['pgid'] != process.pid or identity['session'] != process.pid:
            raise Unavailable()
        state['operation'].update(pid=process.pid, pgid=process.pid, start_ticks=identity['start_ticks'])
        write_state(directory, name, state)

    def on_cleanup(process):
        if process is not None and not operation_absent(state.get('operation'), args.account):
            return
        next_state = {key: value for key, value in state.items() if key != 'operation'}
        write_state(directory, name, next_state)
        state.clear()
        state.update(next_state)

    args._before_spawn, args._on_spawn, args._on_cleanup = before_spawn, on_spawn, on_cleanup


def run_owned(command, timeout, before_spawn=None, on_spawn=None, on_cleanup=None):
    """Own one group; persist lifecycle callbacks and defer cancellation during cleanup."""
    env = {key: value for key, value in os.environ.items()
           if key not in {'CLAUDECODE', 'CLAUDE_CODE_PROVIDER_MANAGED_BY_HOST', 'FORCE_CODE_TERMINAL'}
           and not key.startswith(('ANTHROPIC_', 'CLAUDE_CODE_OAUTH_', 'CLAUDE_CODE_USE_'))}
    if before_spawn is not None:
        before_spawn()
    process = None
    deadline, raw = time.monotonic() + timeout, bytearray()
    try:
        process = subprocess.Popen(command, stdin=subprocess.DEVNULL, stdout=subprocess.PIPE,
                                   stderr=subprocess.DEVNULL, env=env, start_new_session=True)
        if on_spawn is not None:
            on_spawn(process)
        with selectors.DefaultSelector() as selector:
            selector.register(process.stdout, selectors.EVENT_READ)
            while selector.get_map():
                remaining = deadline - time.monotonic()
                if remaining <= 0:
                    raise Unavailable()
                for key, _ in selector.select(remaining):
                    chunk = os.read(key.fileobj.fileno(), 8192)
                    if not chunk:
                        selector.unregister(key.fileobj)
                    raw.extend(chunk)
                    if len(raw) > MAX_BYTES:
                        raise Unavailable()
        if process.wait(timeout=max(0.01, deadline - time.monotonic())) != 0:
            raise Unavailable()
        return loads(raw)
    finally:
        pending = sys.exc_info()[0]
        previous_mask = signal.pthread_sigmask(signal.SIG_BLOCK, {signal.SIGINT, signal.SIGTERM})
        try:
            if process is not None:
                process.stdout.close()
                try:
                    os.killpg(process.pid, signal.SIGTERM)
                except ProcessLookupError:
                    pass
                try:
                    process.wait(timeout=2)
                except subprocess.TimeoutExpired:
                    pass
                try:
                    os.killpg(process.pid, signal.SIGKILL)
                except ProcessLookupError:
                    pass
                process.wait()
            if on_cleanup is not None:
                try:
                    on_cleanup(process)
                except (OSError, Unavailable, ValueError, TypeError, OverflowError):
                    if pending is None:
                        raise
        finally:
            signal.pthread_sigmask(signal.SIG_SETMASK, previous_mask)


def native(args, mode):
    command = ['node', str(Path(__file__).resolve().with_name('claude-account-usage-probe.mjs')),
               mode, args.account, args.sdk, args.cli, args.launcher]
    remaining = args._deadline - time.monotonic()
    if remaining <= 0:
        raise Unavailable()
    callbacks = {key: getattr(args, '_' + key) for key in ('before_spawn', 'on_spawn', 'on_cleanup')
                 if hasattr(args, '_' + key)}
    return run_owned(command, min(17 if mode == 'auth' else PROBE_SECONDS, remaining), **callbacks)


def observe(args, clock=lambda: datetime.now(timezone.utc), invoke=native):
    budget = getattr(args, 'budget_seconds', None)
    if budget is None:
        budget = PROBE_SECONDS
    if type(budget) not in (int, float) or not math.isfinite(budget) or not 0 < budget <= PROBE_SECONDS:
        raise Unavailable()
    args._deadline = time.monotonic() + budget
    name = args.account + '.json'
    with state_directory(args.state_dir) as directory:
        lock = os.open(args.account + '.lock', os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW | os.O_NONBLOCK,
                       0o600, dir_fd=directory)
        try:
            private_file(lock)
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
                locked = True
            except BlockingIOError:
                return unavailable('probe_in_progress')
            state = read_state(directory, name)
            if 'operation' in state:
                if not operation_absent(state['operation'], args.account):
                    return unavailable('native_cleanup_unconfirmed')
                del state['operation']
                write_state(directory, name, state)
            bind_process_lifecycle(args, directory, name, state)
            def save(value):
                if 'operation' in state:
                    value = dict(value, operation=state['operation'])
                write_state(directory, name, value)
            try:
                bound = invoke(args, 'auth')
                if 'operation' in state:
                    return unavailable('native_cleanup_unconfirmed')
                if (type(bound) is not dict or bound.get('status') != 'bound'
                        or bound.get('account') != args.account
                        or bound.get('config_dir') != str(Path.home() / '.claude-t3' / args.account)
                        or not re.fullmatch('[0-9a-f]{64}', bound.get('fingerprint', ''))):
                    raise Unavailable()
                cache = state.get('observation', {})
                if type(cache) is dict and cache.get('fingerprint') == bound['fingerprint']:
                    try:
                        return normalize(cache, args, clock(), 'fresh-cache')
                    except (Unavailable, ValueError, TypeError, OverflowError):
                        pass
                now = clock()
                retry = state.get('retry_not_before')
                if retry is not None:
                    retry = utc(retry)
                    if retry > now:
                        return unavailable('retry_not_before', retry_not_before=stamp(retry))
                observation = invoke(args, 'probe')
                if 'operation' in state:
                    return unavailable('native_cleanup_unconfirmed')
                if type(observation) is not dict or observation.get('fingerprint') != bound['fingerprint']:
                    raise Unavailable()
                result = normalize(observation, args, clock(), 'sdk')
                save({'observation': observation})
                return result
            except KeyboardInterrupt:
                if locked:
                    retry = clock() + timedelta(seconds=COOLDOWN_SECONDS)
                    try:
                        retry = max(retry, utc(state.get('retry_not_before')))
                    except (Unavailable, ValueError, TypeError, OverflowError):
                        pass
                    save({'retry_not_before': stamp(retry)})
                raise
            except (Unavailable, OSError, ValueError, TypeError, OverflowError, RecursionError, subprocess.SubprocessError):
                retry = clock() + timedelta(seconds=COOLDOWN_SECONDS)
                try:
                    previous = utc(state.get('retry_not_before'))
                    retry = max(retry, previous)
                except (Unavailable, ValueError, TypeError, OverflowError):
                    pass
                save({'retry_not_before': stamp(retry)})
                return unavailable('native_observation_unavailable', retry_not_before=stamp(retry))
        finally:
            os.close(lock)


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('account', choices=('malcolm', 'jace'))
    for key in ('sdk', 'cli', 'launcher'):
        parser.add_argument('--' + key, required=True)
    parser.add_argument('--model', required=True)
    parser.add_argument('--purpose', choices=('admission', 'display'), default='admission',
                        help='admission freshness (120 seconds) or display freshness (300 seconds)')
    parser.add_argument('--budget-seconds', type=float,
                        help='remaining native operation seconds, greater than zero and at most 35; cleanup is separate')
    parser.add_argument('--protected', action='store_true', help='caller-supplied reservation metadata')
    parser.add_argument('--state-dir', default=str(Path.home() / '.local/state/codex-v3/claude-usage'))
    args = parser.parse_args(argv)
    if ((args.budget_seconds is not None and (not math.isfinite(args.budget_seconds)
                                              or not 0 < args.budget_seconds <= PROBE_SECONDS))
            or not re.fullmatch(r'claude-(?:opus-5-5|sonnet-[0-9]+-[0-9]+(?:-[0-9]{8})?)', args.model)
            or any(not Path(getattr(args, key)).is_absolute() for key in ('sdk', 'cli', 'launcher'))):
        output = unavailable('invalid_arguments')
    else:
        def cancel(signum, frame):
            raise KeyboardInterrupt()
        previous = {sig: signal.signal(sig, cancel) for sig in (signal.SIGINT, signal.SIGTERM)}
        try:
            output = observe(args)
        except KeyboardInterrupt:
            output = unavailable('cancelled')
        except (Unavailable, OSError, ValueError, TypeError, OverflowError, RecursionError):
            output = unavailable('unsafe_or_invalid_state')
        finally:
            for sig, handler in previous.items():
                signal.signal(sig, handler)
    print(json.dumps(output, allow_nan=False, sort_keys=True))
    return 0 if output['status'] == 'observed' else 1


if __name__ == '__main__':
    sys.exit(main())
