{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.jones.systems/workstreams-t3-provider/1.0.0/provider.schema.json",
  "title": "workstreams-t3-provider/1.0.0",
  "$defs": {
    "Id": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "CommandId": {
      "type": "string",
      "minLength": 16,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "Sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "GitObjectId": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "Version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "Sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "Timestamp": {
      "type": "string",
      "maxLength": 32,
      "pattern": "^(?:(?!0000)[0-9]{4}-(?:(?:01|03|05|07|08|10|12)-(?:0[1-9]|[12][0-9]|3[01])|(?:04|06|09|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8]))|(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26])|(?:0[48]|[2468][048]|[13579][26])00)-02-29)T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,6})?Z$"
    },
    "Protocol": {
      "const": "workstreams-t3-provider/1.0.0"
    },
    "NativeIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "source_instance_id",
        "resource_kind",
        "id_kind",
        "native_id",
        "account_provenance"
      ],
      "properties": {
        "provider": {
          "const": "t3"
        },
        "source_instance_id": {
          "$ref": "#/$defs/Id"
        },
        "resource_kind": {
          "const": "thread"
        },
        "id_kind": {
          "const": "internal"
        },
        "native_id": {
          "$ref": "#/$defs/Id"
        },
        "account_provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "const": "not_account_scoped"
            }
          }
        }
      }
    },
    "Build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "sha",
        "tree"
      ],
      "properties": {
        "repository": {
          "const": "Jones-Systems/Jones-Code"
        },
        "sha": {
          "$ref": "#/$defs/GitObjectId"
        },
        "tree": {
          "$ref": "#/$defs/GitObjectId"
        }
      }
    },
    "ContextRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {}
    },
    "RejectionReason": {
      "enum": [
        "unauthorized",
        "forbidden",
        "caller_mismatch",
        "source_mismatch",
        "unsupported_identity",
        "contract_mismatch",
        "generation_conflict",
        "authority_fenced",
        "thread_not_found",
        "idempotency_conflict",
        "invalid_request"
      ]
    },
    "Rejected": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "state",
        "reason"
      ],
      "properties": {
        "protocol": {
          "$ref": "#/$defs/Protocol"
        },
        "state": {
          "const": "rejected"
        },
        "reason": {
          "$ref": "#/$defs/RejectionReason"
        }
      }
    },
    "Context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner_id",
        "principal_id",
        "source_instance_id",
        "authority_namespace",
        "store_generation",
        "enrollment_id",
        "protocol",
        "build"
      ],
      "properties": {
        "owner_id": {
          "$ref": "#/$defs/Id"
        },
        "principal_id": {
          "$ref": "#/$defs/Id"
        },
        "source_instance_id": {
          "$ref": "#/$defs/Id"
        },
        "authority_namespace": {
          "$ref": "#/$defs/Id"
        },
        "store_generation": {
          "$ref": "#/$defs/Version"
        },
        "enrollment_id": {
          "$ref": "#/$defs/Id"
        },
        "protocol": {
          "$ref": "#/$defs/Protocol"
        },
        "build": {
          "$ref": "#/$defs/Build"
        }
      }
    },
    "ContextResponse": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "protocol",
            "state",
            "context"
          ],
          "properties": {
            "protocol": {
              "$ref": "#/$defs/Protocol"
            },
            "state": {
              "const": "ready"
            },
            "context": {
              "$ref": "#/$defs/Context"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "protocol",
            "state",
            "reason"
          ],
          "properties": {
            "protocol": {
              "$ref": "#/$defs/Protocol"
            },
            "state": {
              "const": "unavailable"
            },
            "reason": {
              "enum": [
                "provider_unconfigured",
                "authority_unavailable",
                "build_unavailable"
              ]
            }
          }
        },
        {
          "$ref": "#/$defs/Rejected"
        }
      ]
    },
    "AttestationRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner_id",
        "principal_id",
        "identity",
        "expected_authority_namespace",
        "expected_store_generation"
      ],
      "properties": {
        "owner_id": {
          "$ref": "#/$defs/Id"
        },
        "principal_id": {
          "$ref": "#/$defs/Id"
        },
        "identity": {
          "$ref": "#/$defs/NativeIdentity"
        },
        "expected_authority_namespace": {
          "$ref": "#/$defs/Id"
        },
        "expected_store_generation": {
          "$ref": "#/$defs/Version"
        }
      }
    },
    "RegistrationAttestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "source_instance_id",
        "authority_namespace",
        "native_id",
        "store_generation",
        "evidence_sha256"
      ],
      "properties": {
        "provider": {
          "const": "t3"
        },
        "source_instance_id": {
          "$ref": "#/$defs/Id"
        },
        "authority_namespace": {
          "$ref": "#/$defs/Id"
        },
        "native_id": {
          "$ref": "#/$defs/Id"
        },
        "store_generation": {
          "$ref": "#/$defs/Version"
        },
        "evidence_sha256": {
          "$ref": "#/$defs/Sha256"
        }
      }
    },
    "AttestationResponse": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "protocol",
            "state",
            "request",
            "attestation",
            "attested_at",
            "expires_at"
          ],
          "properties": {
            "protocol": {
              "$ref": "#/$defs/Protocol"
            },
            "state": {
              "const": "attested"
            },
            "request": {
              "$ref": "#/$defs/AttestationRequest"
            },
            "attestation": {
              "$ref": "#/$defs/RegistrationAttestation"
            },
            "attested_at": {
              "$ref": "#/$defs/Timestamp"
            },
            "expires_at": {
              "$ref": "#/$defs/Timestamp"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "protocol",
            "state",
            "reason"
          ],
          "properties": {
            "protocol": {
              "$ref": "#/$defs/Protocol"
            },
            "state": {
              "const": "unknown"
            },
            "reason": {
              "enum": [
                "authority_changed",
                "authority_unavailable",
                "observation_unavailable"
              ]
            }
          }
        },
        {
          "$ref": "#/$defs/Rejected"
        }
      ]
    },
    "Association": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner_id",
        "principal_id",
        "command_id",
        "native_reference_id",
        "native_action",
        "request_sha256",
        "reservation_sha256"
      ],
      "properties": {
        "owner_id": {
          "$ref": "#/$defs/Id"
        },
        "principal_id": {
          "$ref": "#/$defs/Id"
        },
        "command_id": {
          "$ref": "#/$defs/CommandId"
        },
        "native_reference_id": {
          "$ref": "#/$defs/Id"
        },
        "native_action": {
          "enum": [
            "settle",
            "unsettle"
          ]
        },
        "request_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "reservation_sha256": {
          "$ref": "#/$defs/Sha256"
        }
      }
    },
    "SettlementRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner_id",
        "principal_id",
        "command_id",
        "native_reference_id",
        "native_action",
        "request_sha256",
        "reservation_sha256",
        "identity",
        "expected_authority_namespace",
        "expected_store_generation"
      ],
      "properties": {
        "owner_id": {
          "$ref": "#/$defs/Id"
        },
        "principal_id": {
          "$ref": "#/$defs/Id"
        },
        "command_id": {
          "$ref": "#/$defs/CommandId"
        },
        "native_reference_id": {
          "$ref": "#/$defs/Id"
        },
        "native_action": {
          "enum": [
            "settle",
            "unsettle"
          ]
        },
        "request_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "reservation_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "identity": {
          "$ref": "#/$defs/NativeIdentity"
        },
        "expected_authority_namespace": {
          "$ref": "#/$defs/Id"
        },
        "expected_store_generation": {
          "$ref": "#/$defs/Version"
        }
      }
    },
    "SettlementLookupRequest": {
      "$ref": "#/$defs/SettlementRequest"
    },
    "ResultEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner_id",
        "principal_id",
        "command_id",
        "native_reference_id",
        "native_action",
        "request_sha256",
        "reservation_sha256",
        "result_sha256"
      ],
      "properties": {
        "owner_id": {
          "$ref": "#/$defs/Id"
        },
        "principal_id": {
          "$ref": "#/$defs/Id"
        },
        "command_id": {
          "$ref": "#/$defs/CommandId"
        },
        "native_reference_id": {
          "$ref": "#/$defs/Id"
        },
        "native_action": {
          "enum": [
            "settle",
            "unsettle"
          ]
        },
        "request_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "reservation_sha256": {
          "$ref": "#/$defs/Sha256"
        },
        "result_sha256": {
          "$ref": "#/$defs/Sha256"
        }
      }
    },
    "CommittedResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "native_outcome",
        "native_evidence"
      ],
      "properties": {
        "native_outcome": {
          "const": "committed"
        },
        "native_evidence": {
          "$ref": "#/$defs/ResultEvidence"
        }
      }
    },
    "NoncommittedResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "native_outcome",
        "native_evidence"
      ],
      "properties": {
        "native_outcome": {
          "enum": [
            "denied",
            "unsupported",
            "failed"
          ]
        },
        "native_evidence": {
          "$ref": "#/$defs/ResultEvidence"
        }
      }
    },
    "TerminalResult": {
      "oneOf": [
        {
          "$ref": "#/$defs/CommittedResult"
        },
        {
          "$ref": "#/$defs/NoncommittedResult"
        }
      ]
    },
    "AcceptedReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commandId",
        "aggregateKind",
        "aggregateId",
        "acceptedAt",
        "resultSequence",
        "status"
      ],
      "properties": {
        "commandId": {
          "$ref": "#/$defs/Id"
        },
        "aggregateKind": {
          "const": "thread"
        },
        "aggregateId": {
          "$ref": "#/$defs/Id"
        },
        "acceptedAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "resultSequence": {
          "$ref": "#/$defs/Sequence"
        },
        "status": {
          "const": "accepted"
        }
      }
    },
    "RejectedReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commandId",
        "aggregateKind",
        "aggregateId",
        "acceptedAt",
        "resultSequence",
        "status"
      ],
      "properties": {
        "commandId": {
          "$ref": "#/$defs/Id"
        },
        "aggregateKind": {
          "const": "thread"
        },
        "aggregateId": {
          "$ref": "#/$defs/Id"
        },
        "acceptedAt": {
          "$ref": "#/$defs/Timestamp"
        },
        "resultSequence": {
          "$ref": "#/$defs/Sequence"
        },
        "status": {
          "const": "rejected"
        }
      }
    },
    "SettlementEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eventId",
        "commandId",
        "aggregateKind",
        "aggregateId",
        "sequence",
        "type",
        "occurredAt"
      ],
      "properties": {
        "eventId": {
          "$ref": "#/$defs/Id"
        },
        "commandId": {
          "$ref": "#/$defs/Id"
        },
        "aggregateKind": {
          "const": "thread"
        },
        "aggregateId": {
          "$ref": "#/$defs/Id"
        },
        "sequence": {
          "$ref": "#/$defs/Version"
        },
        "type": {
          "enum": [
            "thread.settled",
            "thread.unsettled"
          ]
        },
        "occurredAt": {
          "$ref": "#/$defs/Timestamp"
        }
      }
    },
    "SettlementResponse": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "protocol",
            "request",
            "state",
            "result",
            "native_receipt",
            "settlement_event"
          ],
          "properties": {
            "protocol": {
              "$ref": "#/$defs/Protocol"
            },
            "request": {
              "$ref": "#/$defs/SettlementRequest"
            },
            "state": {
              "const": "terminal"
            },
            "result": {
              "$ref": "#/$defs/CommittedResult"
            },
            "native_receipt": {
              "$ref": "#/$defs/AcceptedReceipt"
            },
            "settlement_event": {
              "$ref": "#/$defs/SettlementEvent"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "protocol",
            "request",
            "state",
            "result",
            "native_receipt",
            "settlement_event"
          ],
          "properties": {
            "protocol": {
              "$ref": "#/$defs/Protocol"
            },
            "request": {
              "$ref": "#/$defs/SettlementRequest"
            },
            "state": {
              "const": "terminal"
            },
            "result": {
              "$ref": "#/$defs/NoncommittedResult"
            },
            "native_receipt": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/RejectedReceipt"
                }
              ]
            },
            "settlement_event": {
              "type": "null"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "protocol",
            "request",
            "state",
            "reason"
          ],
          "properties": {
            "protocol": {
              "$ref": "#/$defs/Protocol"
            },
            "request": {
              "$ref": "#/$defs/SettlementRequest"
            },
            "state": {
              "const": "unknown"
            },
            "reason": {
              "enum": [
                "attempt_not_found",
                "dispatch_in_progress",
                "receipt_missing",
                "evidence_conflict",
                "authority_changed",
                "authority_unavailable",
                "provider_unavailable"
              ]
            }
          }
        },
        {
          "$ref": "#/$defs/Rejected"
        }
      ]
    },
    "SettlementLookupResponse": {
      "$ref": "#/$defs/SettlementResponse"
    },
    "ProviderRequest": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operation",
            "request"
          ],
          "properties": {
            "operation": {
              "const": "context"
            },
            "request": {
              "$ref": "#/$defs/ContextRequest"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operation",
            "request"
          ],
          "properties": {
            "operation": {
              "const": "attestations"
            },
            "request": {
              "$ref": "#/$defs/AttestationRequest"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operation",
            "request"
          ],
          "properties": {
            "operation": {
              "const": "settlements"
            },
            "request": {
              "$ref": "#/$defs/SettlementRequest"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operation",
            "request"
          ],
          "properties": {
            "operation": {
              "const": "settlements/lookup"
            },
            "request": {
              "$ref": "#/$defs/SettlementLookupRequest"
            }
          }
        }
      ]
    },
    "ProviderResponse": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operation",
            "response"
          ],
          "properties": {
            "operation": {
              "const": "context"
            },
            "response": {
              "$ref": "#/$defs/ContextResponse"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operation",
            "response"
          ],
          "properties": {
            "operation": {
              "const": "attestations"
            },
            "response": {
              "$ref": "#/$defs/AttestationResponse"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operation",
            "response"
          ],
          "properties": {
            "operation": {
              "const": "settlements"
            },
            "response": {
              "$ref": "#/$defs/SettlementResponse"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operation",
            "response"
          ],
          "properties": {
            "operation": {
              "const": "settlements/lookup"
            },
            "response": {
              "$ref": "#/$defs/SettlementLookupResponse"
            }
          }
        }
      ]
    }
  }
}
