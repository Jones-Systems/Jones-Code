{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.jones.systems/workstreams-registration-context/1.0.0/registration-context.schema.json",
  "title": "workstreams-registration-context/1.0.0",
  "$defs": {
    "Id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}(?![\\s\\S])"
    },
    "PositiveVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "RegistryVersion": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "GitObjectId": {
      "type": "string",
      "minLength": 40,
      "maxLength": 40,
      "pattern": "^[a-f0-9]{40}$"
    },
    "Request": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {}
    },
    "AccountProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "const": "not_account_scoped"
        }
      }
    },
    "Build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "sha",
        "tree"
      ],
      "properties": {
        "repository": {
          "const": "Jones-Systems/Jones-Code"
        },
        "sha": {
          "$ref": "#/$defs/GitObjectId"
        },
        "tree": {
          "$ref": "#/$defs/GitObjectId"
        }
      }
    },
    "T3Source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_instance_id",
        "authority_namespace",
        "store_generation",
        "account_provenance",
        "provider",
        "resource_kind",
        "id_kind",
        "native_protocol",
        "build"
      ],
      "properties": {
        "source_instance_id": {
          "$ref": "#/$defs/Id"
        },
        "authority_namespace": {
          "$ref": "#/$defs/Id"
        },
        "store_generation": {
          "$ref": "#/$defs/PositiveVersion"
        },
        "account_provenance": {
          "$ref": "#/$defs/AccountProvenance"
        },
        "provider": {
          "const": "t3"
        },
        "resource_kind": {
          "const": "thread"
        },
        "id_kind": {
          "const": "internal"
        },
        "native_protocol": {
          "const": "workstreams-t3-provider/1.0.0"
        },
        "build": {
          "$ref": "#/$defs/Build"
        }
      }
    },
    "GitHubSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_instance_id",
        "authority_namespace",
        "store_generation",
        "account_provenance",
        "provider",
        "resource_kind",
        "id_kind"
      ],
      "properties": {
        "source_instance_id": {
          "$ref": "#/$defs/Id"
        },
        "authority_namespace": {
          "$ref": "#/$defs/Id"
        },
        "store_generation": {
          "$ref": "#/$defs/PositiveVersion"
        },
        "account_provenance": {
          "$ref": "#/$defs/AccountProvenance"
        },
        "provider": {
          "const": "github"
        },
        "resource_kind": {
          "const": "pull_request"
        },
        "id_kind": {
          "const": "external"
        }
      }
    },
    "Source": {
      "oneOf": [
        {
          "$ref": "#/$defs/T3Source"
        },
        {
          "$ref": "#/$defs/GitHubSource"
        }
      ]
    },
    "Sources": {
      "oneOf": [
        {
          "type": "array",
          "maxItems": 0
        },
        {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "$ref": "#/$defs/Source"
          }
        },
        {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            {
              "$ref": "#/$defs/T3Source"
            },
            {
              "$ref": "#/$defs/GitHubSource"
            }
          ],
          "items": false
        },
        {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            {
              "$ref": "#/$defs/GitHubSource"
            },
            {
              "$ref": "#/$defs/T3Source"
            }
          ],
          "items": false
        }
      ]
    },
    "Response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "state",
        "owner_id",
        "principal_id",
        "grant_id",
        "authorization_revision",
        "server_generation",
        "registry_version",
        "sources"
      ],
      "properties": {
        "protocol": {
          "const": "workstreams-registration-context/1.0.0"
        },
        "state": {
          "const": "ready"
        },
        "owner_id": {
          "$ref": "#/$defs/Id"
        },
        "principal_id": {
          "$ref": "#/$defs/Id"
        },
        "grant_id": {
          "$ref": "#/$defs/Id"
        },
        "authorization_revision": {
          "$ref": "#/$defs/PositiveVersion"
        },
        "server_generation": {
          "$ref": "#/$defs/PositiveVersion"
        },
        "registry_version": {
          "$ref": "#/$defs/RegistryVersion"
        },
        "sources": {
          "$ref": "#/$defs/Sources"
        }
      }
    }
  }
}
