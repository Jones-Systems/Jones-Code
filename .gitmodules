# Map the vendored gitlinks at the repository root so Git's recursive cleanup
# can resolve them even when sparse checkout excludes .repos.
[submodule "distilled"]
	path = .repos/alchemy-effect/submodules/distilled
	url = https://github.com/alchemy-run/distilled.git
[submodule "floci"]
	path = .repos/alchemy-effect/submodules/floci
	url = https://github.com/alchemy-run/floci.git
	shallow = true
	update = none
	ignore = all
